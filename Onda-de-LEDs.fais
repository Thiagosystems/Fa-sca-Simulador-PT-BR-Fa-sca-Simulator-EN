  "comps": [
   {
    "id": "c1",
    "type": "note",
    "x": 40,
    "y": -40,
    "r": 0,
    "tag": "",
    "text": "ONDA DE LEDS — NE555 + 74HC595 + BC548",
    "sh": 1
   },
   {
    "id": "c2",
    "type": "note",
    "x": 40,
    "y": -10,
    "r": 0,
    "tag": "",
    "text": "O NE555 gera o clock (CLK) de cerca de 1 Hz; RV1 ajusta a velocidade.",
    "sh": 1
   },
   {
    "id": "c3",
    "type": "note",
    "x": 40,
    "y": 20,
    "r": 0,
    "tag": "",
    "text": "Q1 inverte a saída serial (SQH) e devolve em SER: os LEDs acendem um a um e depois apagam um a um.",
    "sh": 1
   },
   {
    "id": "c4",
    "type": "note",
    "x": 40,
    "y": 50,
    "r": 0,
    "tag": "",
    "text": "SW1 zera o registrador (RST). Rótulos de rede com o mesmo nome (CLK, SER, RST, SQH, T, QA a QH) estão ligados entre si.",
    "sh": 1
   },
   {
    "id": "c5",
    "type": "note",
    "x": 40,
    "y": 80,
    "r": 0,
    "tag": "",
    "text": "Gire RV1 só até uns 70%: acima disso o clock fica rápido demais para a simulação (passos de 0,1 s).",
    "sh": 1
   },
